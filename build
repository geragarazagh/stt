#!/bin/zsh
# Builds STT.app in this folder. Needs Xcode Command Line Tools and nothing else.
set -e
cd "${0:A:h}"
# It changes per release, not per build.
version=0.4 min=13.0 id=com.geragaraza.stt app=STT.app engine=0.4.1
tmp=$(mktemp -d); trap 'rm -rf $tmp' EXIT
rm -rf "$app" STT.zip
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$app/Contents/Frameworks"

# The engine's prebuilt framework, from its release. vendor/*.swift are its Swift bindings at the same tag.
if [ ! -d vendor/CTranscribe.framework ]; then
  curl -fsSL -o $tmp/x.zip https://github.com/handy-computer/transcribe.cpp/releases/download/v$engine/TranscribeCpp.xcframework.zip
  unzip -q $tmp/x.zip -d $tmp/x
  cp -R $tmp/x/TranscribeCpp.xcframework/macos-arm64_x86_64/CTranscribe.framework vendor/
fi
cp -R vendor/CTranscribe.framework "$app/Contents/Frameworks/"
# Apple silicon only, like the other apps; the Intel half of the framework is 6 MB of nothing here.
bin=$app/Contents/Frameworks/CTranscribe.framework/Versions/A/CTranscribe
lipo "$bin" -thin arm64 -output $tmp/thin && cp $tmp/thin "$bin"

# Updates: Sparkle, from its release, checked against a pinned checksum. Only what a non-sandboxed app
# runs goes into the bundle: no XPC services (they serve sandboxed apps), no headers, Apple silicon only.
sparkle=2.10.1 sparkle_sha=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
if [ ! -d vendor/Sparkle.framework ]; then
  mkdir -p vendor $tmp/sparkle
  curl -fsSL -o $tmp/sparkle.tar.xz https://github.com/sparkle-project/Sparkle/releases/download/$sparkle/Sparkle-$sparkle.tar.xz
  [ "$(shasum -a 256 $tmp/sparkle.tar.xz | cut -d' ' -f1)" = $sparkle_sha ] || { echo "Sparkle checksum mismatch"; exit 1; }
  tar -xf $tmp/sparkle.tar.xz -C $tmp/sparkle Sparkle.framework
  ditto $tmp/sparkle/Sparkle.framework vendor/Sparkle.framework
fi
mkdir -p "$app/Contents/Frameworks"
sp=$app/Contents/Frameworks/Sparkle.framework
ditto vendor/Sparkle.framework "$sp"
rm -rf "$sp"/{XPCServices,Headers,PrivateHeaders,Modules} "$sp"/Versions/B/{XPCServices,Headers,PrivateHeaders,Modules}
for b in Sparkle Autoupdate Updater.app/Contents/MacOS/Updater; do
  lipo "$sp/Versions/B/$b" -thin arm64 -output $tmp/thin && cp $tmp/thin "$sp/Versions/B/$b"
done

swiftc -O -target arm64-apple-macos$min -parse-as-library -module-name STT -F vendor -framework CTranscribe -framework Sparkle \
  -Xlinker -rpath -Xlinker @executable_path/../Frameworks -lc++ -lz -framework Accelerate -framework Metal -framework MetalKit \
  -o "$app/Contents/MacOS/STT" entry.swift engine.swift dictionary.swift window.swift files.swift media.swift download.swift updates.swift vendor/*.swift 2>&1 | grep -E "error" || true
[ -x "$app/Contents/MacOS/STT" ]

# App icon, Apple's way since 2026-11-09: an Icon Composer document (the picture from icon.swift, the plate is the
# system's own fill) compiled by Xcode's actool into Assets.car, which macOS 26+ shows light, dark, clear or tinted with
# the theme, and AppIcon.icns, Apple's light rendition, which macOS 13-15 show. Needs full Xcode; the Command Line Tools
# stay the default developer dir, so swiftc above is the tested one. docs/icon.png and docs/icon-dark.png (README) are
# Icon Composer's own renders at Apple's macOS size: 824 of 1024. Glass, group shadow and translucency are off: with
# Icon Composer's defaults the picture turned to glass (the white wave and the OCR digits vanished in the dark rendition).
# The light picture sits in the specializations list as the entry without an appearance: given as plain image-name,
# Icon Composer ignored the dark entry and darkened the light picture itself (measured with ictool, 2026-11-09).
xc=/Applications/Xcode.app/Contents
swiftc -O -o $tmp/icon icon.swift
mkdir -p $tmp/AppIcon.icon/Assets docs
$tmp/icon $tmp/AppIcon.icon/Assets docs/wave.svg   # and the wave for the site
cat > $tmp/AppIcon.icon/icon.json <<'JSON'
{
  "fill" : "system-light",
  "fill-specializations" : [ { "appearance" : "dark", "value" : "system-dark" } ],
  "groups" : [ { "layers" : [ { "name" : "picture", "glass" : false,
    "image-name-specializations" : [ { "value" : "light.png" }, { "appearance" : "dark", "value" : "dark.png" } ] } ],
    "shadow" : { "kind" : "none", "opacity" : 0.5 }, "translucency" : { "enabled" : false, "value" : 0.5 } } ],
  "supported-platforms" : { "squares" : [ "macOS" ] }
}
JSON
DEVELOPER_DIR=$xc/Developer xcrun actool $tmp/AppIcon.icon --compile "$PWD/$app/Contents/Resources" --platform macosx \
  --minimum-deployment-target $min --app-icon AppIcon --output-partial-info-plist $tmp/icon.plist --target-device mac >/dev/null
for r in Default Dark; do
  "$xc/Applications/Icon Composer.app/Contents/Executables/ictool" $tmp/AppIcon.icon --export-image --output-file $tmp/$r.png \
    --platform macOS --rendition $r --width 206 --height 206 --scale 1 >/dev/null
  sips -p 256 256 $tmp/$r.png --out docs/icon${${r:#Default}:+-dark}.png >/dev/null
done
cp vendor/silero-vad-v6.2-F32.gguf LICENSE THIRD-PARTY-LICENSES.md "$app/Contents/Resources/"
clang -O2 -target arm64-apple-macos$min -dynamiclib -o "$app/Contents/Resources/playing.dylib" playing.c

# Document types: audio and video, so Finder lists STT under Open With. Alternate: a second opener, never the default
# one for a type another app owns, so a double click keeps opening the player people chose.
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>$id</string>
<key>CFBundleName</key><string>STT</string>
<key>CFBundleDisplayName</key><string>STT</string>
<key>CFBundleExecutable</key><string>STT</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>ru</string><string>uk</string></array>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$version</string>
<key>CFBundleVersion</key><string>$version</string>
<key>LSUIElement</key><true/>
<key>LSApplicationCategoryType</key><string>public.app-category.utilities</string>
<key>LSMinimumSystemVersion</key><string>$min</string>
<key>SUFeedURL</key><string>https://github.com/geragarazagh/stt/releases/latest/download/appcast.xml</string>
<key>SUPublicEDKey</key><string>URlTczL/bZGecdDnRO3qHJgOYtOCe5FOPhKetm3FNqY=</string>
<key>SURequireSignedFeed</key><true/>
<key>SUVerifyUpdateBeforeExtraction</key><true/>
<key>SUEnableAutomaticChecks</key><true/>
<key>SUAllowsAutomaticUpdates</key><false/>
<key>CFBundleDocumentTypes</key><array><dict>
  <key>CFBundleTypeName</key><string>Audio or Video</string>
  <key>CFBundleTypeRole</key><string>Viewer</string>
  <key>LSHandlerRank</key><string>Alternate</string>
  <key>LSItemContentTypes</key><array><string>public.audio</string><string>public.movie</string></array>
</dict></array>
<key>NSMicrophoneUsageDescription</key><string>Speech is turned into text on this Mac and goes nowhere.</string>
</dict></plist>
PLIST

for l in ru uk; do
  mkdir "$app/Contents/Resources/$l.lproj"; cp lang/$l.strings "$app/Contents/Resources/$l.lproj/Localizable.strings"
  cp lang/$l.InfoPlist.strings "$app/Contents/Resources/$l.lproj/InfoPlist.strings"
done
mkdir "$app/Contents/Resources/en.lproj"   # English is the text in the code

mkdir -p "$app/Contents/Library/LaunchAgents"
cat > "$app/Contents/Library/LaunchAgents/$id.login.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>$id.login</string>
<key>BundleProgram</key><string>Contents/MacOS/STT</string>
<key>ProgramArguments</key><array><string>Contents/MacOS/STT</string><string>--login</string></array>
<key>AssociatedBundleIdentifiers</key><array><string>$id</string></array>
<key>RunAtLoad</key><true/>
<key>LimitLoadToSessionType</key><string>Aqua</string>
</dict></plist>
PLIST

# Hardened runtime: notarisation requires it, and with it the microphone needs its entitlement.
# disable-library-validation only for ad hoc, which has no team: dyld refused the framework without it
# ("different Team IDs", measured 2026-11-05). A Developer ID build doesn't carry it.
cat > $tmp/e.plist <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.device.audio-input</key><true/>
$([ "${SIGN_ID:--}" = - ] && echo '<key>com.apple.security.cs.disable-library-validation</key><true/>')
</dict></plist>
PLIST
# Ad hoc unless SIGN_ID names a Developer ID certificate. Hardened runtime and a timestamp are what notarisation asks for.
sign=${SIGN_ID:--}; stamp=(); [ "$sign" = - ] || stamp=(--timestamp)
codesign -f -s "$sign" $stamp --options runtime "$app/Contents/Frameworks/CTranscribe.framework"
codesign -f -s "$sign" $stamp --options runtime "$app/Contents/Resources/playing.dylib"
for p in "$sp/Versions/B/Autoupdate" "$sp/Versions/B/Updater.app" "$sp"; do codesign -f -s "$sign" $stamp --options runtime "$p"; done
codesign -f -s "$sign" $stamp --options runtime --entitlements $tmp/e.plist --identifier $id "$app"
echo Done
