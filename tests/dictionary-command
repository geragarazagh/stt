#!/bin/zsh
# Tests stt-cli --add-word / --add-pair (cli.swift, Words.add in shared/dictionary.swift) against a running test copy.
#   TEST=1 ./build, then: tests/dictionary-command "STT Test.app"
# Only the test copy (its own id, defaults and socket), never STT.app: the test empties the dictionary it writes to. It
# runs in a test machine (tart, over ssh), so the window the test copy opens at launch never reaches the person's screen;
# passed there on macOS 26.6.2 and 27.2 (2026-11-18).
# Not covered here: the Dictionary window open during a command (its edit keeps what was added meanwhile); that was
# checked by hand through AX (stt.md, «Checked»).
set -u
app=${1:?usage: dictionary-command "STT Test.app"}
# A full path: `open -a` with a bare name launches whichever STT Test.app LaunchServices knows, an older build left
# elsewhere included, and the cli of this build is then refused by it (2026-11-18, tahoe: 20 cases «Refused: not stt-cli.»).
app=${app:A}
id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist")
[ "$id" = com.geragaraza.stt.test ] || { echo "not the test copy: $id"; exit 2; }
cli=$app/Contents/MacOS/STT
fails=0

# One case: the arguments, the exit code wanted, the answer wanted (standard output or error, whole).
check() {
  local want=$1 says=$2; shift 2
  local out; out=$("$cli" "$@" 2>&1); local got=$?
  if [ $got = $want ] && [ "$out" = "$says" ]; then echo "ok    $*"
  else echo "FAIL  $*: exit $got, «$out» (wanted $want, «$says»)"; fails=$((fails + 1)); fi
}

pkill -f "$cli" 2>/dev/null; sleep 1
check 1 "STT is not running." --add-word Vataga
defaults delete $id words 2>/dev/null; defaults delete $id replacements 2>/dev/null
open -g -a "$app" --args --background
for i in {1..20}; do "$cli" --add-word Probe >/dev/null 2>&1 && break; sleep 0.5; done

check 0 "Already in the dictionary: Probe" --add-word Probe
check 0 "Added: Vataga" --add-word Vataga
check 0 "Already in the dictionary: Vataga" --add-word " Vataga "
check 0 "Changed: Vataga → VATAGA" --add-word VATAGA
check 0 "Already in the dictionary: GitHub" --add-word GitHub
check 0 "Added: ватага → Vataga" --add-pair ватага Vataga
check 0 "Already in the dictionary: ватага → Vataga" --add-pair Ватага Vataga
check 0 "Changed: ватага → Vataga Terminal (was Vataga)" --add-pair ватага "Vataga Terminal"
check 0 "Already in the dictionary: клод → Claude" --add-pair клод Claude
check 0 "Added: github → GitHub" --add-pair github GitHub
check 1 "Heard and written are the same." --add-pair same same
check 1 "Empty." --add-word "  "
check 1 "Control or text-direction characters are not allowed." --add-word $'bad\e[0m'
check 1 "Written: Control or text-direction characters are not allowed." --add-pair x $'line\nrm -rf ~'
check 1 "Written: Control or text-direction characters are not allowed." --add-pair y $'a\xe2\x80\xaeb'
check 1 "Heard: Control or text-direction characters are not allowed." --add-pair $'a\xc2\x85b' z
check 1 "Longer than 200 characters." --add-word $(printf 'a%.0s' {1..201})
usage=$("$cli" --help)
check 1 "$usage" --add-word
check 1 "$usage" --add-pair one
check 1 "$usage" --add-word a b
check 1 "$usage" --frobnicate

# What the app stored: the new ones last, after the built-in lists, each once.
words=$(defaults export $id - | plutil -extract words json -o - -)
pairs=$(defaults export $id - | plutil -extract replacements json -o - -)
[[ $words == *'"NotebookLM","Probe","VATAGA"]' ]] && echo "ok    words stored" || { echo "FAIL  words: $words"; fails=$((fails + 1)); }
[[ $pairs == *'["ватага","Vataga Terminal"],["github","GitHub"]]' ]] && echo "ok    pairs stored" || { echo "FAIL  pairs: ${pairs[-120,-1]}"; fails=$((fails + 1)); }
[ $(echo $pairs | grep -o '\["' | wc -l) -eq 106 ] && echo "ok    106 pairs" || { echo "FAIL  pair count"; fails=$((fails + 1)); }

# List, remove, status, version, history (added 2026-11-23).
"$cli" --list-words | grep -qx "VATAGA" && echo "ok    --list-words" || { echo "FAIL  --list-words"; fails=$((fails + 1)); }
"$cli" --list-pairs | grep -qx $'ватага\tVataga Terminal' && echo "ok    --list-pairs" || { echo "FAIL  --list-pairs"; fails=$((fails + 1)); }
"$cli" --list-words --json | python3 -c 'import json,sys; d=json.load(sys.stdin); assert "VATAGA" in d' && echo "ok    --list-words --json" || { echo "FAIL  --list-words --json"; fails=$((fails + 1)); }
"$cli" --list-pairs --json | python3 -c 'import json,sys; d=json.load(sys.stdin); assert ["ватага","Vataga Terminal"] in d' && echo "ok    --list-pairs --json" || { echo "FAIL  --list-pairs --json"; fails=$((fails + 1)); }
check 0 "Removed: VATAGA" --remove-word vataga
check 1 "Not in the dictionary: VATAGA" --remove-word VATAGA
check 0 "Removed: ватага → Vataga Terminal" --remove-pair Ватага
check 1 "Not in the dictionary: ватага" --remove-pair ватага
"$cli" --version | grep -q "^STT Test " && echo "ok    --version" || { echo "FAIL  --version"; fails=$((fails + 1)); }
"$cli" --status --json | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["running"] is True and d["words"] == 25 and d["pairs"] == 105' && echo "ok    --status --json" || { echo "FAIL  --status --json"; fails=$((fails + 1)); }
"$cli" --history --json | python3 -c 'import json,sys; assert json.load(sys.stdin) == []' && echo "ok    --history --json" || { echo "FAIL  --history --json"; fails=$((fails + 1)); }

pkill -f "$cli"
echo "$fails failed"
exit $((fails > 0))
